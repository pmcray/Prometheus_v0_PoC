    "## ⚖️ IEE_v1: Benchmark Performance
",
    "Running the static **Prometheus-Bench-v1** suite."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from prometheus.iee_v1 import IEEV1
",
    "import json
",
    "
",
    "iee = IEEV1()
",
    "print(f"Loaded {len(iee.bench.problems)} problems from Prometheus-Bench-v1.")
",
    "
",
    "# Evaluate an agent on a specific problem
",
    "problem_id = "PB-001" # Sorting
",
    "naive_sort_code = """
",
    "def sort_list(data):
",
    "    for i in range(len(data)):
",
    "        for j in range(len(data)-1): 
",
    "            if data[j] > data[j+1]: data[j], data[j+1] = data[j+1], data[j]
",
    "    return data
",
    """"
",
    "
",
    "result = iee.evaluate_agent_on_problem(problem_id, naive_sort_code)
",
    "print(f"Evaluation Results for {problem_id}:")
",
    "print(json.dumps(result, indent=2))
",
    "
",
    "fitness = iee.calculate_fitness("agent_0", [result])
",
    "print(f"Overall Fitness Score: {fitness}")"
   ]
