# Prometheus Production Dockerfile
# Optimized for deploying Go/Chess bots to online platforms

FROM python:3.10-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    git \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first (for caching)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY . .

# Install Prometheus in editable mode
RUN pip install -e .

# Create directories for models and logs
RUN mkdir -p /app/models /app/logs

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV TF_CPP_MIN_LOG_LEVEL=2

# Default command (can be overridden)
CMD ["python", "prometheus_cli.py", "quickstart"]

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import prometheus; print('OK')" || exit 1

# Labels
LABEL maintainer="Prometheus AI Team"
LABEL version="0.69"
LABEL description="Prometheus - Recursive Self-Improvement Framework"
