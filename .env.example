# Prometheus Environment Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# OGS (Online Go Server) Configuration
# =============================================================================
# Get API token from: https://online-go.com/user/settings
# After creating a bot account and requesting bot status

# For 9x9 Go Bot
OGS_USERNAME_9X9=MyPrometheusBot9x9
OGS_API_TOKEN_9X9=your_ogs_api_token_here

# For 19x19 Go Bot (optional - can use same or different account)
OGS_USERNAME_19X19=MyPrometheusBot19x19
OGS_API_TOKEN_19X19=your_ogs_api_token_here

# =============================================================================
# Lichess Configuration
# =============================================================================
# Get API token from: https://lichess.org/account/oauth/token
# Scopes needed: bot:play, challenge:read, challenge:write
# WARNING: Upgrading account to BOT is IRREVERSIBLE!

LICHESS_TOKEN=your_lichess_token_here

# =============================================================================
# Prometheus Configuration
# =============================================================================
# Logging level: DEBUG, INFO, WARNING, ERROR
PROMETHEUS_LOG_LEVEL=INFO

# Enable GPU if available (0 = disabled, 1 = enabled)
CUDA_VISIBLE_DEVICES=0

# TensorFlow logging level (0=ALL, 1=INFO, 2=WARNING, 3=ERROR)
TF_CPP_MIN_LOG_LEVEL=2

# =============================================================================
# Advanced Configuration (Optional)
# =============================================================================
# Model paths (if using custom locations)
# GO_9X9_MODEL=models/go_9x9.h5
# GO_19X19_MODEL=models/go_19x19.h5
# CHESS_MODEL=models/chess.h5

# MCTS configuration
# MCTS_SIMULATIONS=400
# MCTS_C_PUCT=1.0
# MCTS_DIRICHLET_ALPHA=0.3

# Deployment configuration
# MAX_CONCURRENT_GAMES=5
# AUTO_ACCEPT_CHALLENGES=true
# MIN_OPPONENT_RANK=15k
# MAX_OPPONENT_RANK=1d
